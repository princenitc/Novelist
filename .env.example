# HTTP service
PORT=8081
LOG_LEVEL=INFO

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# RabbitMQ (set RABBITMQ_ENABLED=false to run without a broker)
RABBITMQ_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=novelist
RABBITMQ_PASSWORD=password

# CORS — space-separated allowed origins ("*" = allow all, development only)
CORS_ORIGINS=*

# JWT — change JWT_SECRET_KEY to a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# RAG (Retrieval-Augmented Generation)
# Embedding model downloaded from HuggingFace on first use (~90 MB)
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
